": {"money": 1, "time": 3}, "flags": {"career": "디자이너"}, "concepts": ["employment"]}, "venture": {"label": "동네 가게 창업", "text": "손님과 직접 만나며 시작했다. 운영의 불확실성도 함께 배운다.", "effects": {"money": 1, "bond": 2}, "flags": {"career": "창업가"}, "concepts": ["employment", "labor"]}, "service": {"label": "돌봄·지역 서비스", "text": "이웃의 삶을 가까이에서 돕는다. 감정적 노동에도 휴식이 필요하다.", "effects": {"money": 1, "bond": 2}, "flags": {"career": "지역 돌봄"}, "concepts": ["employment", "elder_care"]}}}, "housing": {"stages": [0], "title": "새집을 찾아서", "intro": "전셋값과 생활비를 계산한 미라가 여러 열쇠를 건넨다. ‘넓이가 전부는 아니죠. 거리, 관계, 비용을 함께 보세요.’", "choices": {"rent": {"label": "작고 가까운 임대주택", "text": "주거비를 줄이고 출퇴근 시간을 아꼈다.", "effects": {"money": 2, "time": 1}, "flags": {"housing": "작은 임대주택"}, "concepts": ["housing"]}, "share": {"label": "이웃과 함께 사는 집", "text": "공간을 함께 쓰며 생활 규칙을 조율한다.", "effects": {"money": 1, "bond": 2}, "flags": {"housing": "공동 주거"}, "concepts": ["housing", "values"]}, "house": {"label": "생활 공간이 넉넉한 집", "text": "공간의 자유가 커졌다. 관리비도 함께 늘었다.", "effects": {"money": -1, "energy": 1}, "flags": {"housing": "일반 주택"}, "concepts": ["housing"]}}}, "shop": {"stages": [0, 1], "title": "카페에 사람이 없다", "intro": "점심시간인데 카페가 한산하다. 지호는 ‘주변 청년이 이사하고, 가게 인력 구하기도 힘들어요’라며 메뉴판을 내려놓는다.", "choices": {"help": {"label": "잠깐 일손을 돕는다", "text": "차를 나르고 작은 보수를 받았다. 인력 부족이 가게에 미치는 영향을 느꼈다.", "effects": {"money": 1, "time": -1, "bond": 1}, "flags": {}, "concepts": ["labor"]}, "talk": {"label": "왜 손님이 줄었는지 조사", "text": "주거비와 일자리 문제가 지역 상권에까지 이어진다는 것을 발견했다.", "effects": {"insight": 2}, "flags": {}, "concepts": ["labor", "housing"]}, "route": {"label": "지역 장터 행사를 제안", "text": "주민들이 새로운 손님을 만날 통로가 생겼다. 그러나 지속적인 일자리 대책도 필요하다.", "effects": {"bond": 2}, "flags": {}, "concepts": ["labor", "policy"]}}}, "young": {"stages": [0, 1], "title": "떠나는 친구의 편지", "intro": "나리가 이력서를 접어 가방에 넣는다. ‘계속 이곳에서 살고 싶은데, 안정적인 일과 집을 구하기가 어려워.’ 마을의 미래를 고민한다.", "choices": {"job": {"label": "일자리 정보를 함께 찾는다", "text": "구직과 직업 훈련의 문턱을 확인했다.", "effects": {"bond": 1, "insight": 1}, "flags": {},